# Copiá este archivo a .env.production y completá con valores reales (nunca lo subas).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES_IN=15d
JWT_REFRESH_EXPIRES_IN=15d

VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

NODE_ENV=production
CORS_ORIGINS=https://tu-frontend.example.com

API_KEY=your_secure_api_key
