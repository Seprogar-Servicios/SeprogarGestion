# Configuración de la API
API_URL=https://tu-backend.example.com/api
API_KEY=your_secure_api_key

# Grupos de WhatsApp permitidos (separados por comas)
GRUPOS_PERMITIDOS=Grupo de Prueba,Soporte Técnico

# Usuario predeterminado para crear tareas (ID de MongoDB)
DEFAULT_USER_ID=your_default_user_id

# URLs para la API del worker
CHECK_DUPLICATE_URL=https://tu-backend.example.com/api/worker/tareas/check-duplicate
CREATE_TASK_URL=https://tu-backend.example.com/api/worker/tareas

# Nivel de logs (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
