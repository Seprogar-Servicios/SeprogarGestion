# Mantener la estructura de la sesión de WhatsApp pero ignorar archivos temporales
# NO eliminar estas carpetas - son necesarias para la sesión

# Ignorar archivos temporales y de bloqueo dentro de la sesión
.wwebjs_auth/**/*.log
.wwebjs_auth/**/*.tmp
.wwebjs_auth/**/LOCK
.wwebjs_auth/**/LOG*
.wwebjs_auth/**/CURRENT
.wwebjs_auth/**/MANIFEST*
.wwebjs_auth/**/*.ldb
.wwebjs_auth/**/*.blob

# Archivos comprimidos
*.zip
*.7z
*.tar
*.gz
