{
  "name": "futurgas-whatsapp-worker",
  "version": "1.0.0",
  "description": "Background worker para procesar mensajes de WhatsApp y crear tareas",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:memory": "node --max-old-space-size=384 --expose-gc index.js",
    "dev": "nodemon index.js",
    "dev:memory": "nodemon --exec \"node --max-old-space-size=384 --expose-gc\" index.js"
  },
  "dependencies": {
    "@sparticuz/chromium": "^138.0.2",
    "axios": "^1.11.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.3.1",
    "p-queue": "^8.0.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}