    "express": "^5.1.0",
    "p-queue": "^9.0.1",
    "p-timeout": "^7.0.1",
    "puppeteer-core": "^24.18.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.33.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
